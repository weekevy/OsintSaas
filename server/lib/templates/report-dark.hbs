<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{title}}</title>
<style>
  /* --- FONTS --- */
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&family=Orbitron:wght@400;700&display=swap');

  /* --- CSS VARIABLES --- */
  :root {
    --bg-page: #0d1117;
    --bg-card: #080a0d;
    --bg-header: #111620;
    --border-primary: #2a3447;
    --text-primary: #f0f3f8;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --accent-blue: #60a5fa;
    --accent-red: #ff4d4d;
    --accent-orange: #f97316;
    --accent-yellow: #facc15;
    --accent-green: #22c55e;
    --font-display: 'Rajdhani', 'Orbitron', sans-serif;
    --font-mono: 'Share Tech Mono', monospace;
  }

  /* --- RESET --- */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  @page {
    size: A4;
    margin: 0;
  }

  body {
    background-color: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.75;
    -webkit-print-color-adjust: exact;
  }

  .document {
    width: 100%;
    min-height: 297mm;
  }

  .page-content {
    padding: 40px 48px;
    position: relative;
    page-break-after: always;
  }

  /* =====================================================
     HERO SECTION
     ===================================================== */
  .hero-block {
    margin-bottom: 24px;
  }

  .badge-label {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 8px;
    display: block;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 4px;
  }

  .hero-subtitle {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  /* =====================================================
     METADATA GRID (Ref matched)
     ===================================================== */
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 32px;
  }

  .meta-cell {
    padding: 12px 16px;
    border-right: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
  }

  .meta-cell:nth-child(2), .meta-cell:nth-child(4), .meta-cell:nth-child(6), .meta-cell:nth-child(8) {
    grid-column: span 1;
  }
  .meta-cell:nth-child(1), .meta-cell:nth-child(3), .meta-cell:nth-child(5), .meta-cell:nth-child(7) {
    grid-column: span 1;
    background: var(--bg-header);
    width: 95px;
  }
  
  /* Adjusted for 4-column layout with labels as separate cells like Ref */
  .meta-grid {
    display: grid;
    grid-template-columns: 95px 1fr 95px 1fr;
  }

  .meta-label {
    font-family: var(--font-display);
    font-size: 8px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .meta-value {
    font-size: 9.5px;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  /* =====================================================
     RISK SCORE BANNER
     ===================================================== */
  .risk-banner {
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 32px;
  }

  .risk-gauge-container {
    text-align: center;
    min-width: 120px;
  }

  .risk-gauge-circle {
    width: 80px;
    height: 80px;
    margin: 0 auto 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4px solid var(--border-primary);
    border-radius: 50%;
    position: relative;
  }
  
  .risk-gauge-circle::after {
    content: '';
    position: absolute;
    top: -4px; left: -4px; right: -4px; bottom: -4px;
    border: 4px solid {{riskColor}};
    border-radius: 50%;
    clip-path: polygon(50% 50%, -50% -50%, 150% -50%); /* Approximation */
  }

  .risk-score-text {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: {{riskColor}};
  }

  .risk-level-text {
    font-size: 7px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .risk-details {
    flex: 1;
  }

  .risk-details-title {
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .risk-details-subtitle {
    font-size: 8px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .severity-progress-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sev-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 7.5px;
  }

  .sev-label {
    width: 60px;
    color: var(--text-muted);
  }

  .sev-progress-bg {
    flex: 1;
    height: 5px;
    background: var(--bg-header);
    border-radius: 1px;
    overflow: hidden;
  }

  .sev-progress-fill {
    height: 100%;
  }

  .sev-count {
    width: 20px;
    text-align: right;
    font-weight: 700;
  }

  .sev-fill-critical { background: var(--accent-red); }
  .sev-fill-high     { background: var(--accent-orange); }
  .sev-fill-medium   { background: var(--accent-yellow); }
  .sev-fill-low      { background: var(--accent-green); }

  /* =====================================================
     SECTION STYLING
     ===================================================== */
  .section-header-bar {
    background: var(--bg-header);
    height: 36px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-left: 4px solid var(--accent-blue);
    margin-bottom: 16px;
    margin-top: 24px;
  }

  .section-number {
    color: var(--text-muted);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9px;
    margin-right: 12px;
  }

  .section-title {
    color: var(--text-primary);
    font-size: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
  }

  .section-body {
    color: var(--text-primary);
    font-size: 9.5px;
    line-height: 1.6;
  }

  /* =====================================================
     METHODOLOGY TABLE
     ===================================================== */
  .method-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--border-primary);
  }

  .method-table th {
    background: var(--bg-header);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 8px;
    text-transform: uppercase;
    padding: 8px 12px;
    text-align: left;
    font-weight: 700;
  }

  .method-table td {
    padding: 12px;
    font-size: 8.5px;
    border: 1px solid var(--border-primary);
    vertical-align: top;
  }

  .method-table tr:nth-child(even) { background: var(--bg-card); }
  .method-table tr:nth-child(odd)  { background: var(--bg-page); }

  /* =====================================================
     FINDING CARDS
     ===================================================== */
  .finding-card {
    background: var(--bg-card);
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    margin-bottom: 16px;
    overflow: hidden;
    page-break-inside: avoid;
    display: flex;
  }

  .finding-accent {
    width: 4px;
    background: var(--accent-orange);
  }
  
  .finding-content {
    flex: 1;
    padding: 0;
  }

  .finding-header {
    background: var(--bg-header);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-primary);
  }

  .finding-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .finding-index {
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 8px;
    font-weight: 700;
  }

  .finding-title {
    color: var(--text-primary);
    font-size: 9.5px;
    font-weight: 700;
    font-family: var(--font-display);
  }

  .finding-sev-badge {
    font-size: 7.5px;
    text-transform: uppercase;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 0;
  }

  .finding-sev-badge.critical { background: var(--accent-red); color: var(--bg-page); }
  .finding-sev-badge.high     { background: var(--accent-orange); color: var(--bg-page); }
  .finding-sev-badge.medium   { background: var(--accent-yellow); color: var(--bg-page); }
  .finding-sev-badge.low      { background: var(--accent-green); color: var(--bg-page); }

  .finding-body {
    padding: 12px;
    font-size: 9px;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-primary);
  }

  .finding-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: 12px;
    font-size: 8px;
  }

  .fm-item {
    display: flex;
    gap: 4px;
  }

  .fm-label {
    color: var(--text-muted);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
  }

  .fm-value {
    color: var(--text-primary);
  }

  .finding-remediation {
    background: var(--bg-header);
    padding: 12px;
    margin: 4px;
    border-radius: 2px;
  }

  .remediation-label {
    font-family: var(--font-display);
    font-size: 8px;
    font-weight: 700;
    color: var(--accent-orange);
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .remediation-text {
    font-size: 8.5px;
    color: var(--text-primary);
  }

  /* --- UTILS --- */
  .mt-0 { margin-top: 0; }

</style>
</head>
<body>

<div class="document">
  
  <!-- PAGE 1: COVER & EXECUTIVE SUMMARY -->
  <div class="page-content">
    
    <div class="hero-block">
      <span class="badge-label">Intelligence Dossier</span>
      <h1 class="hero-title">Threat Assessment Report</h1>
      <p class="hero-subtitle">{{scanType}} \227 OSINT Reconnaissance &amp; Cyber Threat Analysis</p>
      
      <div class="meta-grid">
        <div class="meta-cell"><span class="meta-label">Target URL</span></div>
        <div class="meta-cell"><span class="meta-value">{{targetUrl}}</span></div>
        <div class="meta-cell"><span class="meta-label">Report Ref</span></div>
        <div class="meta-cell"><span class="meta-value">{{reportRef}}</span></div>
        
        <div class="meta-cell"><span class="meta-label">Scan Type</span></div>
        <div class="meta-cell"><span class="meta-value">{{scanType}}</span></div>
        <div class="meta-cell"><span class="meta-label">Date Issued</span></div>
        <div class="meta-cell"><span class="meta-value">{{dateIssued}}</span></div>
        
        <div class="meta-cell"><span class="meta-label">Investigator</span></div>
        <div class="meta-cell"><span class="meta-value">{{investigator}}</span></div>
        <div class="meta-cell"><span class="meta-label">Classification</span></div>
        <div class="meta-cell"><span class="meta-value">{{classification}}</span></div>
        
        <div class="meta-cell"><span class="meta-label">Project</span></div>
        <div class="meta-cell"><span class="meta-value">{{project}}</span></div>
        <div class="meta-cell"><span class="meta-label">Detections</span></div>
        <div class="meta-cell"><span class="meta-value">{{findingsCount}} Threat Indicators Identified</span></div>
      </div>
    </div>

    <!-- RISK SCORE BANNER -->
    <div class="risk-banner">
      <div class="risk-gauge-container">
        <div class="risk-gauge-circle">
          <div class="risk-score-text">{{riskScore}}%</div>
        </div>
        <div class="risk-level-text">HIGH RISK</div>
      </div>
      
      <div class="risk-details">
        <div class="risk-details-title">COMPOSITE RISK SCORE</div>
        <div class="risk-details-subtitle">Automated OSINT Reconnaissance \227 Job Recruitment Dossier</div>
        
        <div class="severity-progress-list">
          <div class="sev-row">
            <span class="sev-label">CRITICAL</span>
            <div class="sev-progress-bg"><div class="sev-progress-fill sev-fill-critical" style="width: 20%"></div></div>
            <span class="sev-count" style="color:var(--accent-red)">{{criticalCount}}</span>
          </div>
          <div class="sev-row">
            <span class="sev-label">HIGH</span>
            <div class="sev-progress-bg"><div class="sev-progress-fill sev-fill-high" style="width: 80%"></div></div>
            <span class="sev-count" style="color:var(--accent-orange)">{{highCount}}</span>
          </div>
          <div class="sev-row">
            <span class="sev-label">MEDIUM</span>
            <div class="sev-progress-bg"><div class="sev-progress-fill sev-fill-medium" style="width: 0%"></div></div>
            <span class="sev-count">{{mediumCount}}</span>
          </div>
          <div class="sev-row">
            <span class="sev-label">LOW</span>
            <div class="sev-progress-bg"><div class="sev-progress-fill sev-fill-low" style="width: 0%"></div></div>
            <span class="sev-count">{{lowCount}}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 01: EXECUTIVE SUMMARY -->
    <div class="section-header-bar mt-0">
      <span class="section-number">01</span>
      <span class="section-title">Executive Summary</span>
    </div>
    <div class="section-body">
      <p>{{executiveSummary}}</p>
      <br>
      <p>The automated reconnaissance pipeline dispatched ten specialized sub-orchestrator modules across the target's digital infrastructure. Each module independently gathered intelligence from public sources including DNS records, email authentication infrastructure, social media platforms, business registries, TLS certificate authorities, and subdomain enumeration databases. All findings were cross-referenced against global threat intelligence feeds and scored using a weighted risk algorithm.</p>
      <br>
      <p><strong>Assessment Verdict:</strong> The aggregate of findings yields a composite risk score of {{riskScore}}% \227 {{riskLevel}}. {{findingsCount}} threat indicators were identified, with findings spanning critical email authentication failures, unverifiable corporate identity, absent web security certificates, and an anomalous digital footprint incompatible with the claimed organizational profile. Immediate investigative escalation and precautionary measures are strongly advised before any further engagement with the recruiting entity.</p>
    </div>

  </div>

  <!-- PAGE 2: METHODOLOGY -->
  <div class="page-content">
    
    <div class="section-header-bar mt-0">
      <span class="section-number">02</span>
      <span class="section-title">Analysis Methodology</span>
    </div>
    <div class="section-body">
      <p>The investigation employs a multi-layered, non-intrusive reconnaissance architecture adhering to established OSINT operational security standards. No active exploitation, unauthorized access, or intrusive probing of the target's infrastructure was performed at any stage.</p>
      <br>
      <table class="method-table">
        <thead>
          <tr>
            <th>Phase</th>
            <th>Module</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {{#each methodologyPhases}}
          <tr>
            <td>{{phase}}</td>
            <td>{{module}}</td>
            <td>{{description}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- SECTION 03: DETAILED INTELLIGENCE DETECTIONS -->
    <div class="section-header-bar">
      <span class="section-number">03</span>
      <span class="section-title">Detailed Intelligence Detections</span>
    </div>
    <div class="section-body">
      <p>The following {{findingsCount}} threat indicators were identified across the target's infrastructure. Each finding includes the originating module, source type, technical evidence, and a specific remediation recommendation. Findings are listed in order of assessed impact.</p>
      <br>
      {{#each detailedFindings}}
      <div class="finding-card">
        <div class="finding-accent"></div>
        <div class="finding-content">
          <div class="finding-header">
            <div class="finding-title-row">
              <span class="finding-index">{{index}}</span>
              <span class="finding-title">{{title}}</span>
            </div>
            <span class="finding-sev-badge {{severity}}">{{severity}}</span>
          </div>
          <div class="finding-body">
            {{description}}
          </div>
          <div class="finding-meta-grid">
            <div class="fm-item"><span class="fm-label">Module:</span> <span class="fm-value">{{module}}</span></div>
            <div class="fm-item"><span class="fm-label">Source:</span> <span class="fm-value">{{source}}</span></div>
            <div class="fm-item"><span class="fm-label">Domain:</span> <span class="fm-value">{{domain}}</span></div>
            <div class="fm-item"><span class="fm-label">Status:</span> <span class="fm-value">{{status_label}}</span></div>
            <div class="fm-item"><span class="fm-label">Risk Score:</span> <span class="fm-value">{{risk_score}} / 100</span></div>
          </div>
          <div class="finding-remediation">
            <div class="remediation-label">Recommended Action</div>
            <div class="remediation-text">{{remediation}}</div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

  </div>

</div>

</body>
</html>
